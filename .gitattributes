# Normalize every text file to LF in the repository.
# Keep LF in the working tree as well, including PowerShell scripts.
* text=auto eol=lf

# PowerShell scripts must stay ASCII-only. See AGENTS.md section 9.
*.ps1 text eol=lf

*.md   text diff=markdown
# The review template is a protocol file the validator reads: LF in every checkout, also under core.autocrlf=true.
templates/reviews/REVIEW.md text eol=lf
*.json text
*.sh   text eol=lf
