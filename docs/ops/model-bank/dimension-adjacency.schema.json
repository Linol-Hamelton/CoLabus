{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "rules", "rows"],
  "properties": {
    "schema": { "type": "string", "enum": ["dimension-adjacency/1"] },
    "source": { "type": "string", "minLength": 1 },
    "rules": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "nearest", "basis"],
        "properties": {
          "dimension": { "type": "string", "pattern": "^D-[A-Z]{2,12}$" },
          "nearest": { "type": "array", "items": { "type": "string", "pattern": "^D-[A-Z]{2,12}$" } },
          "basis": { "type": "string", "minLength": 1, "maxLength": 400 }
        }
      }
    }
  }
}
