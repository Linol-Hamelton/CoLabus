{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "register-launch/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "launchId", "packageId", "packageLabel", "baseSha", "ordinal", "issuedAt", "provenance"],
  "properties": {
    "schema": {"const": "register-launch/1"},
    "launchId": {"type": "string", "pattern": "^L(?!000000)[0-9]{6}$"},
    "packageId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "packageLabel": {"type": "string", "pattern": "^(?:[A-Z0-9][A-Z0-9-]{0,63}|none)$"},
    "baseSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 999999},
    "issuedAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "ownerAct", "previousRecord"],
      "properties": {
        "owner": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "ownerAct": {"type": "string", "minLength": 1, "maxLength": 1024},
        "previousRecord": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}]}
      }
    }
  },
  "x-byte-contract": "UTF-8 no BOM, NFC, LF, exactly one final LF, <=65536 bytes, unique decoded JSON keys. Ordinal equals launchId digits. Previous digest is null iff ordinal is 1. The reader enforces these cross-field constraints."
}
