{
  "$schema": "cycle-outputs/2",
  "type": "object",
  "required": ["schema", "directories", "suffixes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "enum": ["cycle-outputs/2"] },
    "directories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(docs|tools)/(?!.*\\.\\.)[A-Za-z0-9._/-]+$" }
    },
    "suffixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.[a-z0-9][a-z0-9._-]*$" }
    }
  }
}
