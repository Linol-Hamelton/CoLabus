      "required": ["mimo", "kilo", "codex", "vibe", "cline", "kimi", "opencode", "claude", "default"],
      "properties": {
        "mimo": {"type":"integer","minimum":0,"maximum":4},
        "kilo": {"type":"integer","minimum":0,"maximum":9},
        "codex": {"type":"integer","minimum":0,"maximum":4},
        "vibe": {"type":"integer","minimum":0,"maximum":3},
        "cline": {"type":"integer","minimum":0,"maximum":4},
        "kimi": {"type":"integer","minimum":0,"maximum":2},
        "opencode": {"type":"integer","minimum":0,"maximum":3},
        "claude": {"type":"integer","minimum":0,"maximum":3},
