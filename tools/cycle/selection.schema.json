{
  "type":"object","additionalProperties":false,"required":["schema","packages"],
  "properties":{
    "schema":{"enum":["cycle-selection/1"]},
    "packages":{"type":"array","items":{
      "type":"object","additionalProperties":false,"required":["stream","sha","seats"],
      "properties":{
        "stream":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},
        "sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},
        "seats":{"type":"array","items":{
          "type":"object","additionalProperties":false,"required":["client","model","role","source"],
          "properties":{
            "client":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,30}$"},
            "model":{"type":"string","minLength":1,"maxLength":200},
            "role":{"enum":["certifier","certifier-strong","certifier-medium"]},
            "source":{"enum":["l3-select"]},
            "effort":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,31}$"},
            "launch":{
              "type":"object","additionalProperties":false,"required":["name","worktree","promptFile","routeId"],
              "properties":{
                "name":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"},
                "worktree":{"type":"string","minLength":1},
                "promptFile":{"type":"string","minLength":1},
                "routeId":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,63}$"}
              }
            }
          }
        }}
      }
    }}
  }
}
