{
  "schema": "clients/1",
  "clients": {
    "claude": {
      "autoApprove": {
        "interactive": {
          "state": "measured",
          "file": "~/.claude/settings.json",
          "format": "json",
          "keys": [
            {
              "path": [
                "permissions",
                "defaultMode"
              ],
              "value": "bypassPermissions"
            },
            {
              "path": [
                "skipDangerousModePermissionPrompt"
              ],
              "value": true
            }
          ],
          "note": "autoContinueAtUsageLimit (also set by the operator) is not an approval key and is not checked"
        },
        "seat": {
          "mode": "bypass",
          "flags": [
            "--dangerously-skip-permissions"
          ],
          "basis": "argv of docs/ops/cert-launch.cjs, docs/ops/fix-launch.cjs and tools/operator/seats.cjs"
        },
        "stall": [
          {
            "id": "claude-not-granted",
            "regex": "requested permissions? to .{1,200}? but you haven'?t granted it",
            "basis": "unmeasured: no real prompt text was captured; fixture outputs only"
          }
        ],
        "verify": "node docs/ops/channels-approve.cjs check --client claude"
      },
      "binary": "claude",
      "models": [
        "claude-opus-5-5",
        "claude-sonnet-5",
        "claude-haiku-4-5",
        "claude-fable-5-1"
      ],
      "capabilities": {
        "fileWrite": true,
        "mcp": true,
        "hooks": ".claude/settings.json",
        "resume": true
      },
      "command": [
        "claude",
        "-p",
        "{message}",
        "--model",
        "{model}",
        {
          "if": "effort",
          "args": [
            "--effort",
            "{effort}"
          ]
        },
        "--permission-mode",
        "acceptEdits",
        "--allowedTools",
        "Read",
        "Grep",
        "Glob",
        "Write",
        "Edit",
        "Bash(node:*)",
        "Bash(git:*)",
        "Bash(powershell:*)"
      ],
      "model": {
        "how": "flag",
        "listing": null
      },
      "effort": {
        "how": "flag",
        "values": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      },
      "resume": {
        "command": [
          "claude",
          "-r",
          "{sessionId}"
        ],
        "sessionId": "printed in launch output"
      },
      "usage": "none",
      "present": false,
      "version": null,
      "verifiedOn": null,
      "source": "product-contract",
      "env": {},
      "failureModes": []
    },
    "codex": {
      "autoApprove": {
        "interactive": {
          "state": "measured",
          "file": "~/.codex/config.toml",
          "format": "toml",
          "keys": [
            {
              "table": [],
              "key": "approval_policy",
              "value": "never"
            },
            {
              "table": [],
              "key": "sandbox_mode",
              "value": "danger-full-access"
            }
          ],
          "note": "a CODEX_HOME override of the config directory is not followed (open item)"
        },
        "seat": {
          "mode": "review",
          "flags": [
            "--approve-for-me"
          ],
          "basis": "argv of docs/ops/cert-launch.cjs and tools/operator/seats.cjs; codex exec --help 2026-10-28: route approval requests through automatic review using the workspace-write sandbox",
          "alternative": {
            "mode": "bypass",
            "flags": [
              "--dangerously-bypass-approvals-and-sandbox"
            ],
            "switch": "COLABUS_CODEX_SEAT_APPROVAL=bypass (cert-launch only, linked worktree only); default stays review until the owner decides",
            "basis": "codex exec --help, measured 2026-10-28"
          }
        },
        "stall": [
          {
            "id": "codex-approve-command",
            "regex": "^\\s*(?:Approve|Allow) (?:this )?(?:command|edit|patch)\\b.*\\?",
            "basis": "unmeasured: no real prompt text was captured; fixture outputs only"
          }
        ],
        "verify": "node docs/ops/channels-approve.cjs check --client codex"
      },
      "binary": "codex",
      "models": [
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-5.6-luna",
        "gpt-6-astra"
      ],
      "capabilities": {
        "fileWrite": true,
        "mcp": "~/.codex/config.toml",
        "hooks": ".codex/hooks.json",
        "resume": true
      },
      "command": [
        "codex",
        "exec",
        "-m",
        "{model}",
        {
          "if": "effort",
          "args": [
            "-c",
            "model_reasoning_effort={effort}"
          ]
        },
        "--approve-for-me",
        "--skip-git-repo-check",
        "-C",
        "{workdir}",
        "{message}"
      ],
      "model": {
        "how": "flag",
        "listing": [
          "codex",
          "debug",
          "models"
        ]
      },
      "effort": {
        "how": "config",
        "values": [
          "none",
          "low",
          "medium",
          "high",
          "xhigh"
        ]
      },
      "resume": {
        "command": [
          "codex",
          "exec",
          "resume",
          "{sessionId}"
        ],
        "sessionId": "printed in launch output"
      },
      "usage": "codex-tokens",
      "present": false,
