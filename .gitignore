# Claude Code local overrides (personal, never shared)
.claude/settings.local.json

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.swp
*~

# Scratch space for agents. Nothing here is project state.
.ai/scratch/
.ai/runtime/
.ai/backups/

# Durable local system outcomes; exported only with explicit consent.
.ai/outcomes/

# The nested work root of the read-handle sampled check (an earlier revision removed that code path; an older
# checkout still runs it, and it can land in a checkout whose temp root is inside the checkout).
rh-w-*/

# Never track secrets.
.env
.env.*
*.key
*.pem
docs/product/launch-records/launches/pending/

# local indexes and tool state rebuilt by IDE servers (a 25 MB graph database must never be staged)
.codebase-memory/
.mimocode/
